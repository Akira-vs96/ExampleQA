              "exec": [
                "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Search finds product id 1', function () { const body = pm.response.json(); pm.expect(body).to.be.an('array').that.is.not.empty; pm.expect(body[0].id).to.eql(1); });",
                "pm.test('Search matches keyboard regardless of case', function () { pm.expect(pm.response.json()[0].name.toLowerCase()).to.include('keyboard'); });",
                "pm.test('Response time under 200 ms', function () { pm.expect(pm.response.responseTime).to.be.below(200); });"
              ],
