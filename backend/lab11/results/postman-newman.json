            "script": {
              "id": "bf11facd-0282-4c1c-9ee3-d667485b1ab2",
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is JSON array with 3 products', function () { const body = pm.response.json(); pm.expect(body).to.be.an('array').with.lengthOf(3); });",
                "pm.test('Each product has id, name, and price', function () { pm.response.json().forEach(function (product) { pm.expect(product).to.have.all.keys('id', 'name', 'price'); }); });",
                "pm.test('Response time under 200 ms', function () { pm.expect(pm.response.responseTime).to.be.below(200); });"
              ],
              "_lastExecutionId": "75fc8f40-d86e-4e89-8f79-4a706aae4568"
            }
          }
        ]
      },
